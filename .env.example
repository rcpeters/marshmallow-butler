# Google Gemini API (required for gemini-4-hydrogen)
GEMINI_API_KEY=your_gemini_api_key_here

# SO-101 Follower hardware
SO101_FOLLOWER_PORT=/dev/so101_follower
SO101_FOLLOWER_ID=so101_follower_main

# Cameras (pin via /dev/v4l/by-id/... after Phase 3)
CAM_OVERHEAD_DEVICE=/dev/video0
CAM_WRIST_DEVICE=/dev/video2

# Local Voice Containers (Docker Compose service hostnames)
GEMMA_API_URL=http://gemma-llm:8000/v1/chat/completions
GEMMA_MODEL=gemma-4-e2b
ASR_API_URL=http://whisper-asr:8000/v1/audio/transcriptions
TTS_API_URL=http://local-tts:8000/v1/audio/speech
