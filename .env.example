# Google Gemini API (required for gemini-4-hydrogen)
GEMINI_API_KEY=your_gemini_api_key_here

# SO-101 Follower hardware
SO101_FOLLOWER_PORT=/dev/ttyACM1
SO101_FOLLOWER_ID=so101_follower_main

# Cameras (pin via /dev/v4l/by-id/... after Phase 3)
CAM_OVERHEAD_DEVICE=/dev/video0
CAM_WRIST_DEVICE=/dev/video2

# Local Voice Containers & ALSA Audio Devices (VENTUNO Q)
GEMMA_API_URL=http://llamacpp-models-runner:9999/v1/chat/completions
GEMMA_MODEL=gemma-4-E2B_q4_0-it
ASR_API_URL=http://audio-analytics-runner:8085/audio-analytics/v1/api
ASR_WS_URL=ws://audio-analytics-runner:8085/stream
ASR_MODEL=whisper-small-quantized
TTS_API_URL=http://kokoro-tts:9100/speak
TTS_VOICE=bm_george
TTS_LANG=en-gb
KWS_API_URL=http://ei-keyword-spot-runner:1337
ALSA_CAPTURE_DEVICE=plughw:CARD=Array,DEV=0
ALSA_PLAYBACK_DEVICE=plughw:CARD=Device,DEV=0
